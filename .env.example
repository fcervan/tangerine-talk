# Copie para `.env` e preencha. NUNCA versione o `.env`.
# Este arquivo só contém placeholders — nenhum valor real deve entrar aqui.

# ---------------------------------------------------------------- aplicação
APP_ENV=dev
# Gere com: openssl rand -hex 32
# Usado para criptografar as chaves de provedor salvas pelos usuários.
APP_SECRET_KEY=

# ------------------------------------------------------------------ banco
MYSQL_DATABASE=tangerine
MYSQL_USER=tangerine
MYSQL_PASSWORD=troque-me
MYSQL_ROOT_PASSWORD=troque-me-tambem
DATABASE_URL=mysql+asyncmy://tangerine:troque-me@mysql:3306/tangerine

# ------------------------------------------------------------------ e-mail
# Convites são enviados por e-mail. Sem SMTP configurado, a aplicação mostra o
# link de convite para o owner copiar e enviar manualmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tangerine Talk <no-reply@localhost>
SMTP_TLS=true

# --------------------------------------------------------- provedores de IA
# As chaves de IA NÃO ficam aqui: cada usuário cadastra a sua na aplicação,
# e ela é criptografada no banco. Este arquivo nunca guarda chave de ninguém.

# ------------------------------------------------------- opcionais / escala
# Sem Redis, a aplicação usa fila em processo e ranking pelo banco.
REDIS_URL=
# Padrão: ./data/storage (volume local). S3 é opcional.
STORAGE_BACKEND=local
# 0 = processa o áudio e descarta imediatamente.
AUDIO_RETENTION_DAYS=0
# 1 = força Ollama local e desliga recursos que dependem de nuvem.
OFFLINE_MODE=0
OLLAMA_BASE_URL=http://ollama:11434
